{
  "name": "exhibit-connect",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "exhibit-connect",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@exhibit-connect/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@exhibit-connect/projection": {
      "resolved": "packages/projection",
      "link": true
    },
    "node_modules/@exhibit-connect/server": {
      "resolved": "packages/server",
      "link": true
    },
    "packages/core": {
      "name": "@exhibit-connect/core",
      "version": "0.1.0"
    },
    "packages/projection": {
      "name": "@exhibit-connect/projection",
      "version": "0.1.0"
    },
    "packages/server": {
      "name": "@exhibit-connect/server",
      "version": "0.1.0",
      "dependencies": {
        "@exhibit-connect/core": "0.1.0"
      }
    }
  }
}
